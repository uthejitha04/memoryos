# Reference only; export variables into the server process environment.
# Optional data override; use a disposable directory for verification.
# MEMORYOS_DATA=C:/Projects/.tmp/memoryos-test
# MEMORYOS_MODEL=tiny
# PAIRING_TOKEN=
# NVIDIA_API_KEY=            # Nemotron; when set it answers alone (no fallback chain)
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# GROQ_API_KEY=              # Groq whisper-large-v3 speech; also an LLM fallback only without NVIDIA
# MEMORYOS_SUMMARY_PROVIDER=nvidia
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# MEMORYOS_SYNC_URL=
# MEMORYOS_SYNC_TOKEN=
